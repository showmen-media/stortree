[Unit]
Description=rclone mount %i (managed by stortree, do not edit by hand)
After=network-online.target
Wants=network-online.target
{% if entry.requires_slug %}
After=stortree-mount@{{ entry.requires_slug }}.service
RequiresMountsFor={{ stortree_root }}/{{ entry.local_path }}
{% endif %}

[Service]
Type=notify
User={{ stortree_user }}
Group={{ stortree_group }}
ExecStart=/usr/bin/rclone mount {{ entry.remote }} {{ (stortree_root ~ '/' ~ entry.local_path) if entry.local_path else stortree_root }} \
  --config {{ stortree_etc }}/rclone.conf \
{% for k, v in entry.args.items() %}
  --{{ k }}{{ ' ' ~ (v | string) if (v is not sameas true) else '' }} \
{% endfor %}
  --allow-other
ExecStop=/bin/fusermount -uz {{ (stortree_root ~ '/' ~ entry.local_path) if entry.local_path else stortree_root }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
